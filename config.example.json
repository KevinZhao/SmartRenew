      "secret_key": "REPLACE_ME",
      "regions": ["us-east-1", "us-west-2"]
    },
    {
      "alias": "dev-team",
      "account_id": "234567890123",
      "access_key": "AKIA_REPLACE_ME",
      "secret_key": "REPLACE_ME",
